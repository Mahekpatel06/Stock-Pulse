<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <!-- 1. Dynamically read the Grafana Cloud URL from Render environment variables -->
            <!-- Note: Ensure your environment variable includes the full path up to /loki/api/v1/push -->
            <url>${GRAFANA_LOKI_URL}</url>
            
            <!-- 2. Grafana Cloud REQUIRES basic authentication -->
            <auth>
                <username>${GRAFANA_LOKI_USER}</username>
                <password>${GRAFANA_LOKI_TOKEN}</password>
            </auth>
            
            <connectionTimeoutMs>60000</connectionTimeoutMs> 
            <requestTimeoutMs>15000</requestTimeoutMs>
            
            <!-- 3. Performance warning: sending logs 1-by-1 can lag your app in production -->
            <!-- I changed these to healthier production defaults, but you can revert if needed -->
            <batchMaxItems>1000</batchMaxItems>
            <batchTimeoutMs>1000</batchTimeoutMs>
        </http>
        <format>
            <label>
                <pattern>app=Stock-Pulse,host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %replace(%msg){"(Authorization: Bearer |Bearer )[a-zA-Z0-9\-_]+\.[a-zA-Z0-9\-_]+\.[a-zA-Z0-9\-_]+|(\"password\"\s*[:=]\s*)\"[^\"]+\"|(\bpassword=)[^&amp;\s,]+", "$1$2$3******"}%n</pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOKI" />
    </root>
    
    <!-- Specifically send Security DEBUG logs to Loki -->
    <logger name="org.springframework.security" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOKI" />
    </logger>
    
    <!-- Specifically send Web/API logs to Loki -->
    <logger name="org.springframework.web" level="DEBUG" additivity="false">
        <appender-ref ref="LOKI" />
    </logger>

</configuration>
